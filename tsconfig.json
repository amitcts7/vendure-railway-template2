{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "target": "es2020",
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./"
  },
  "exclude": ["node_modules", "migration.ts", "vite.config.mts"],
  "ts-node": {
    "files": true
  }
}
